# Anthropic
ANTHROPIC_API_KEY=

# Neo4j (self-hosted on DigitalOcean droplet)
NEO4J_URI=bolt://NEO4J_HOST:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Upstash Redis (REST API, not raw redis://)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# OpenSanctions
OPENSANCTIONS_API_URL=https://api.opensanctions.org
# OPENSANCTIONS_API_KEY=  # only if required for higher rate limits

# CORS — comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000

# Which agent implementation to use
# "native" = hand-rolled Anthropic tool-use loop (Phase 1)
# "graph"  = LangGraph (Phase 2, stubbed)
AGENT_IMPL=native

# Server
LOG_LEVEL=INFO
PORT=8080
